# vLLM OpenAI-compatible server (started separately with `vllm serve`)
HOSTED_VLLM_API_BASE=http://localhost:8000/v1

# Optional: Langfuse tracing. Without these, spans go nowhere.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# Optional: Weights & Biases. Without this, --wandb is skipped.
# WANDB_API_KEY=

# Optional: Hugging Face Hub. A write token; without it, --hf-repo is skipped.
# HF_TOKEN=

# autosolve mode: AiZynthFinder models. A relative path is resolved against the directory
# you run from (normally the repo root); an absolute path also works.
# <AZ_MODELS_PATH>/<--az-model>/config.yml must exist (see "Getting the AiZynthFinder
# models" in README.md). AZ_MODEL_CONFIG_PATH is only the fallback when it does not.
# AZ_MODELS_PATH=az_models
# AZ_MODEL_CONFIG_PATH=
