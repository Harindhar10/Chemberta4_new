# vLLM OpenAI-compatible server (started separately with `vllm serve`)
HOSTED_VLLM_API_BASE=http://localhost:8000/v1

# Optional: Langfuse tracing. Without these, spans go nowhere.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# Optional: Weights & Biases. Without this, --wandb is skipped.
# WANDB_API_KEY=

# Optional: Hugging Face Hub. A write token; without it, --hf-repo is skipped.
# HF_TOKEN=
